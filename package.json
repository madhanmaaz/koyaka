{
    "name": "koyaka-monorepo",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev:koyaka": "node ./scripts/build-koyaka.js --dev",
        "build:koyaka": "node ./scripts/build-koyaka.js",
        "dev:vanilla": "node ./scripts/build-vanilla.js --dev",
        "build:vanilla": "node ./scripts/build-vanilla.js",
        "build:registry": "node ./scripts/build-registry.js",
        "build": "npm run build:koyaka && npm run build:vanilla && npm run build:registry"
    },
    "devDependencies": {
        "chokidar": "^5.0.0",
        "esbuild": "^0.28.2",
        "sass": "^1.101.0",
        "solid-js": "^1.9.17"
    }
}
